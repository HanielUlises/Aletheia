(define (problem spy-linear-a6-k4-r5-d2)
    (:domain spy-ring)
    (:requirements :typing :equality :facts :finitary-S5-theories :modal-goals :negative-goals)

    (:agents A B C D E M)
    (:objects r1 r2 r3 r4 r5 - room k1 k2 k3 k4 - key)

    (:facts-init
        (adjacent r1 r2) (adjacent r2 r1) (adjacent r2 r3) (adjacent r3 r2) (adjacent r3 r4) (adjacent r4 r3) (adjacent r4 r5) (adjacent r5 r4) (codebook A k1) (codebook B k2) (codebook C k3) (codebook D k4) (mole M)
    )

    (:init
        (:and
            (at A r1)
            (at B r2)
            (at C r3)
            (at D r4)
            (at E r5)
            (at M r3)
            ([C. All] (and (at A r1) (at B r2) (at C r3) (at D r4) (at E r5) (at M r3) (not (at A r2)) (not (at A r3)) (not (at A r4)) (not (at A r5)) (not (at B r1)) (not (at B r3)) (not (at B r4)) (not (at B r5)) (not (at C r1)) (not (at C r2)) (not (at C r4)) (not (at C r5)) (not (at D r1)) (not (at D r2)) (not (at D r3)) (not (at D r5)) (not (at E r1)) (not (at E r2)) (not (at E r3)) (not (at E r4)) (not (at M r1)) (not (at M r2)) (not (at M r4)) (not (at M r5))))
            (secret k1)
            (secret k2)
            (secret k3)
            (secret k4)
            ([C. All] ([Kw. A] (secret k1)))
            ([C. All] ([Kw. B] (secret k2)))
            ([C. All] ([Kw. C] (secret k3)))
            ([C. All] ([Kw. D] (secret k4)))
        )
    )

    (:goal
        (and
            ([Kw. A] (secret k1))
            ([Kw. A] (secret k2))
            ([Kw. A] (secret k3))
            ([Kw. A] (secret k4))
            ([Kw. B] (secret k1))
            ([Kw. B] (secret k2))
            ([Kw. B] (secret k3))
            ([Kw. B] (secret k4))
            ([Kw. C] (secret k1))
            ([Kw. C] (secret k2))
            ([Kw. C] (secret k3))
            ([Kw. C] (secret k4))
            ([Kw. D] (secret k1))
            ([Kw. D] (secret k2))
            ([Kw. D] (secret k3))
            ([Kw. D] (secret k4))
            ([Kw. E] (secret k1))
            ([Kw. E] (secret k2))
            ([Kw. E] (secret k3))
            ([Kw. E] (secret k4))
            (not ([Kw. M] (secret k1)))
            (not ([Kw. M] (secret k2)))
            (not ([Kw. M] (secret k3)))
            (not ([Kw. M] (secret k4)))
            ([A] (not ([Kw. M] (secret k1))))
            ([A] (not ([Kw. M] (secret k2))))
            ([A] (not ([Kw. M] (secret k3))))
            ([A] (not ([Kw. M] (secret k4))))
            ([B] (not ([Kw. M] (secret k1))))
            ([B] (not ([Kw. M] (secret k2))))
            ([B] (not ([Kw. M] (secret k3))))
            ([B] (not ([Kw. M] (secret k4))))
            ([C] (not ([Kw. M] (secret k1))))
            ([C] (not ([Kw. M] (secret k2))))
            ([C] (not ([Kw. M] (secret k3))))
            ([C] (not ([Kw. M] (secret k4))))
            ([D] (not ([Kw. M] (secret k1))))
            ([D] (not ([Kw. M] (secret k2))))
            ([D] (not ([Kw. M] (secret k3))))
            ([D] (not ([Kw. M] (secret k4))))
            ([E] (not ([Kw. M] (secret k1))))
            ([E] (not ([Kw. M] (secret k2))))
            ([E] (not ([Kw. M] (secret k3))))
            ([E] (not ([Kw. M] (secret k4))))
        )
    )
)
