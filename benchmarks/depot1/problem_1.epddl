;; Doxastic Depot 1 -- plant a false belief.
;;
;; Everything starts as common knowledge (an S5 model), and the goal asks for a
;; state in which the chief *believes* crate c1 is still in bay1 while it is in
;; fact in bay2: a false belief, hence a KD45 (non-reflexive) model.
;;
;; Expected plan (length 2):
;;   (go chief bay1 bay2)  -- the chief leaves the bay where c1 sits
;;   (relocate rob1 c1 bay1 bay2)  -- rob1 moves it, unseen by the chief

(define (problem depot-1)
    (:domain doxastic-depot)

    (:requirements
        :KD45-frames
        :finitary-S5-theories
        :modal-goals
        :negative-goals
        :negative-preconditions
        :facts
    )

    (:agents chief rob1 rob2)

    (:objects bay1 bay2 bay3 - bay
              c1 c2 - crate
    )

    (:facts-init
        (adjacent bay1 bay2) (adjacent bay2 bay1)
        (adjacent bay2 bay3) (adjacent bay3 bay2)
        (office bay3)
    )

    (:init
        (:and
            ;; Agents: everybody is in bay1
            (:forall (?i - agent)
                (:and (at-ag ?i bay1) (not (at-ag ?i bay2)) (not (at-ag ?i bay3)))
            )
            ;; Crates: c1 in bay1, c2 in bay3, none sealed
            (at c1 bay1) (not (at c1 bay2)) (not (at c1 bay3))
            (at c2 bay3) (not (at c2 bay1)) (not (at c2 bay2))
            (not (sealed c1)) (not (sealed c2))
            ;; ... and all of that is common knowledge
            ([C. All]
                (forall (?i - agent)
                    (and (at-ag ?i bay1) (not (at-ag ?i bay2)) (not (at-ag ?i bay3)))
                )
            )
            ([C. All]
                (and (at c1 bay1) (not (at c1 bay2)) (not (at c1 bay3))
                     (at c2 bay3) (not (at c2 bay1)) (not (at c2 bay2))
                     (not (sealed c1)) (not (sealed c2))
                )
            )
        )
    )

    (:goal
        (and
            (at c1 bay2)
            ([chief] (at c1 bay1))
        )
    )
)
