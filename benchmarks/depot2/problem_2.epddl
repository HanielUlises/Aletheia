;; Doxastic Depot 2 -- second-order false belief.
;;
;; Same setting as depot-1, but the goal is nested: rob1 must *believe that the
;; chief believes* something false.  This exercises modal depth 2 over a KD45
;; model, where the inner belief is not knowledge (it fails at the real world).
;;
;; Expected plan (length 2):
;;   (go chief bay1 bay2)
;;   (relocate rob1 c1 bay1 bay2)

(define (problem depot-2)
    (:domain doxastic-depot)

    (:requirements
        :KD45-frames
        :finitary-S5-theories
        :modal-goals
        :negative-goals
        :negative-preconditions
        :facts
    )

    (:agents chief rob1 rob2)

    (:objects bay1 bay2 bay3 - bay
              c1 c2 - crate
    )

    (:facts-init
        (adjacent bay1 bay2) (adjacent bay2 bay1)
        (adjacent bay2 bay3) (adjacent bay3 bay2)
        (office bay3)
    )

    (:init
        (:and
            (:forall (?i - agent)
                (:and (at-ag ?i bay1) (not (at-ag ?i bay2)) (not (at-ag ?i bay3)))
            )
            (at c1 bay1) (not (at c1 bay2)) (not (at c1 bay3))
            (at c2 bay3) (not (at c2 bay1)) (not (at c2 bay2))
            (not (sealed c1)) (not (sealed c2))
            ([C. All]
                (forall (?i - agent)
                    (and (at-ag ?i bay1) (not (at-ag ?i bay2)) (not (at-ag ?i bay3)))
                )
            )
            ([C. All]
                (and (at c1 bay1) (not (at c1 bay2)) (not (at c1 bay3))
                     (at c2 bay3) (not (at c2 bay1)) (not (at c2 bay2))
                     (not (sealed c1)) (not (sealed c2))
                )
            )
        )
    )

    (:goal
        (and
            (at c1 bay2)
            ([chief] (at c1 bay1))
            ([rob1] ([chief] (at c1 bay1)))
            ([rob1] (at c1 bay2))
        )
    )
)
