<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aletheia</name>
  <version>0.2.0</version>
  <description>
    Epistemic planner for Dynamic Epistemic Logic tasks over S5n and KD45n
    frames: the epistemic_planner binary, and its planning core as a library.
  </description>
  <maintainer email="hanielulises2003@gmail.com">Haniel Ulises</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>cmake</buildtool_depend>

  <depend>nlohmann-json-dev</depend>

  <export>
    <build_type>cmake</build_type>
  </export>
</package>
